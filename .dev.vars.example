# Cloudflare Pages Functions local variables. Rename to .dev.vars for local wrangler dev.
PUBLIC_BASE_URL=http://localhost:8788
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Payment provider: yoomoney or yookassa
PAYMENT_PROVIDER=yoomoney
YOOMONEY_RECEIVER=4100XXXXXXXXXXXX
YOOMONEY_NOTIFICATION_SECRET=YOUR_YOOMONEY_HTTP_NOTIFICATION_SECRET

# Optional YooKassa instead of YooMoney
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_TOKEN=

# Telegram bot
TELEGRAM_BOT_USERNAME=SellerMoney_Pro_bot
TELEGRAM_BOT_TOKEN=PASTE_BOT_TOKEN_HERE
ADMIN_TELEGRAM_CHAT_ID=

# Admin & contacts
ADMIN_TOKEN=GENERATE_LONG_RANDOM_TOKEN
SUPPORT_EMAIL=slava.plekhanov.2002@gmail.com
SUPPORT_VK=https://vk.com/bread1996
